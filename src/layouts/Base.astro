---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Terminal from '../components/Terminal.astro';
import XRay from '../components/XRay.astro';
import { contactLinks } from '../data/contact';

interface Props { title: string; description?: string; showFooter?: boolean }
const { title, description = 'Matt Kam — frontend engineer with a design background.', showFooter = true } = Astro.props;
const fullTitle = title === 'Home' ? 'Matt Kam' : `${title} | Matt Kam`;
// Same form as the site's own links: no trailing slash except on the home page.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Choose your own adventure (components/Adventure.astro): a visit that starts on the
      // home page opens on the chooser, once per session. Decided before paint, so no flash.
      try {
        var adv = sessionStorage.getItem('adventure');
        if (!adv) sessionStorage.setItem('adventure', adv = location.pathname === '/' ? 'choosing' : 'skipped');
        if (adv === 'choosing' && location.pathname === '/' && location.hash !== '#terminal') document.documentElement.classList.add('choosing');
      } catch (e) { /* No storage: go straight to the site. */ }
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#e4eaec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a2b" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {showFooter && (
      <footer class="site-footer" id="contact" data-x="Base.astro › footer">
        <svg class="hills" viewBox="0 0 1440 240" preserveAspectRatio="xMinYMax slice" aria-hidden="true">
          <circle cx="320" cy="92" r="56" fill="var(--lamp)" opacity="0.85" />
          <path d="M0 120 C 240 60 420 110 640 90 S 1100 40 1440 130 V240 H0Z" fill="var(--mist-deep)" />
          <path d="M0 190 C 220 140 460 170 700 150 S 1200 130 1440 180 V240 H0Z" fill="var(--pine)" opacity="0.55" />
          <path d="M0 225 C 300 195 620 215 860 205 S 1260 195 1440 215 V240 H0Z" fill="var(--hill-front)" />
        </svg>
        <div class="foot wrap">
        <h2>Get in touch</h2>
        <p>
          {contactLinks.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> / </span>}
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a>
            </>
          ))}
        </p>
        </div>
      </footer>
    )}
    <ContactPanel />
    <Terminal />
    <XRay />
  </body>
</html>

<style>
  .site-footer { margin-top: 6rem; overflow: hidden; }
  /* Never shorter than the drawing's own ratio, so wide screens don't crop the sun and hilltops;
     on phones the min-height trims the right side instead, keeping the sun. */
  .hills { display: block; width: 100%; aspect-ratio: 1440 / 240; height: auto; min-height: 7rem; }
  .foot { background: var(--hill-front); max-width: none; margin-top: -1px; padding-block: 1.5rem 3.5rem; padding-inline: max(var(--gutter), calc((100% - 72rem) / 2 + var(--gutter))); }
  /* The band is dark in both themes, so its text doesn't follow --ink. */
  .site-footer h2 { font-size: var(--step-2); color: #e6ecef; }
  .foot p { color: #e6ecef; margin: 0; }
  .foot :global(a:hover) { color: var(--lamp); }
</style>
