---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Terminal from '../components/Terminal.astro';
import { contactLinks } from '../data/contact';

interface Props { title: string; description?: string; showFooter?: boolean }
const { title, description = 'Matt Kam — frontend engineer with a design background.', showFooter = true } = Astro.props;
const fullTitle = title === 'Home' ? 'Matt Kam' : `${title} | Matt Kam`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#e4eaec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a2b" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {showFooter && (
      <footer class="site-footer wrap" id="contact">
        <h2>Get in touch</h2>
        <p>
          {contactLinks.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> / </span>}
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a>
            </>
          ))}
        </p>
      </footer>
    )}
    <ContactPanel />
    <Terminal />
  </body>
</html>

<style>
  .site-footer { padding-block: 5rem 3rem; margin-top: 6rem; position: relative; }
  .site-footer::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); border-top: 1px solid var(--mist-deep); }
  .site-footer h2 { font-size: var(--step-2); }
</style>
