---
/**
 * Placeholder hero. The multiplane version replaces this file only.
 * Contract: full-bleed section, contains the h1, ends where #work begins.
 * The planes are already separate elements with a --depth value so the
 * scroll/pointer/gyro camera can drive them later.
 */
---
<section class="hero" aria-labelledby="hero-title">
  <div class="planes" aria-hidden="true">
    <svg class="plane" style="--depth: 0" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <circle cx="1080" cy="170" r="70" fill="var(--lamp)" opacity="0.85" />
    </svg>
    <svg class="plane" style="--depth: 1" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path d="M0 380 C 220 300 380 330 560 290 S 900 250 1100 310 S 1360 300 1440 280 V600 H0Z" fill="var(--mist-deep)" />
    </svg>
    <svg class="plane" style="--depth: 2" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path d="M0 460 C 180 400 340 430 520 410 S 860 360 1040 420 S 1300 430 1440 400 V600 H0Z" fill="var(--pine)" opacity="0.55" />
    </svg>
    <svg class="plane" style="--depth: 3" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path d="M0 540 C 260 500 520 520 760 505 S 1200 490 1440 520 V600 H0Z" fill="var(--ink)" opacity="0.85" />
    </svg>
  </div>
  <div class="wrap copy">
    <h1 id="hero-title">Matt Kam</h1>
    <p class="lede">
      Frontend engineer who started as a designer. Twelve years building interfaces people
      pay for, most recently rewards and loyalty at Recharge.
    </p>
    <a class="cta" href="#work">See the work</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 56rem);
    display: grid;
    align-items: start;
    overflow: hidden;
    margin-top: -4.5rem; /* sit under the sticky nav */
    padding-top: clamp(7rem, 18vh, 11rem);
  }
  .planes { position: absolute; inset: 0; }
  .plane { position: absolute; inset: 0; width: 100%; height: 100%; }
  .copy { position: relative; }
  h1 { font-size: var(--step-5); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.3em; }
  .lede { font-size: var(--step-1); max-width: 34ch; color: var(--ink-soft); margin: 0 0 2rem; }
  .cta {
    display: inline-block;
    font-family: var(--font-display); font-weight: 600;
    background: var(--ink); color: var(--mist);
    padding: 0.8rem 1.4rem; border-radius: 999px; text-decoration: none;
  }
  .cta:hover { color: var(--mist); background: var(--pine); }
</style>
