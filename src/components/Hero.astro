---
/**
 * Placeholder hero. The multiplane version replaces this file only.
 * Contract: full-bleed section, contains the h1, ends where #work begins.
 * Each plane has a --depth value. The pointer camera below shifts deeper
 * (nearer) planes further toward the cursor, then eases them home when the
 * cursor leaves. Off for touch-only devices and reduced motion.
 */
---
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="planes" aria-hidden="true" data-planes>
    <svg class="plane" style="--depth: 0.5" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <circle cx="1080" cy="170" r="70" fill="var(--lamp)" opacity="0.85" />
    </svg>
    <svg class="plane" style="--depth: 1" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path d="M0 380 C 220 300 380 330 560 290 S 900 250 1100 310 S 1360 300 1440 280 V600 H0Z" fill="var(--mist-deep)" />
    </svg>
    <svg class="plane" style="--depth: 2" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path d="M0 460 C 180 400 340 430 520 410 S 860 360 1040 420 S 1300 430 1440 400 V600 H0Z" fill="var(--pine)" opacity="0.55" />
    </svg>
    <svg class="plane" style="--depth: 3" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
      <path d="M0 540 C 260 500 520 520 760 505 S 1200 490 1440 520 V600 H0Z" fill="var(--hill-front)" opacity="0.85" />
    </svg>
  </div>
  <div class="wrap copy">
    <h1 id="hero-title">Matt Kam</h1>
    <p class="lede">
      Frontend engineer who started as a designer. Twelve years building interfaces people
      pay for, most recently rewards and loyalty at Recharge.
    </p>
    <a class="cta" href="#work">See the work</a>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const planes = hero?.querySelector<HTMLElement>('[data-planes]');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && planes && canHover && !reduce) {
    let target = { x: 0, y: 0 };
    let pos = { x: 0, y: 0 };
    let inside = false;
    let raf = 0;
    let last = 0;

    // Time constants in ms: quick to follow, slow to drift home.
    const FOLLOW = 140;
    const RETURN = 900;

    const tick = (now: number) => {
      const dt = Math.min(64, now - (last || now));
      last = now;
      const k = 1 - Math.exp(-dt / (inside ? FOLLOW : RETURN));
      pos.x += (target.x - pos.x) * k;
      pos.y += (target.y - pos.y) * k;
      planes.style.setProperty('--cx', pos.x.toFixed(4));
      planes.style.setProperty('--cy', pos.y.toFixed(4));
      if (Math.abs(target.x - pos.x) + Math.abs(target.y - pos.y) > 0.001) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
        last = 0;
      }
    };
    const start = () => { if (!raf) raf = requestAnimationFrame(tick); };

    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      // -1..1 from the hero's center
      target = { x: ((e.clientX - r.left) / r.width - 0.5) * 2, y: ((e.clientY - r.top) / r.height - 0.5) * 2 };
      inside = true;
      start();
    });
    hero.addEventListener('pointerleave', () => {
      target = { x: 0, y: 0 };
      inside = false;
      start();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 56rem);
    display: grid;
    align-items: start;
    overflow: hidden;
    margin-top: -4.5rem; /* sit under the sticky nav */
    padding-top: clamp(7rem, 18vh, 11rem);
  }
  /* Bleed past the hero so shifted planes never expose an edge; .hero clips it. */
  .planes { position: absolute; inset: -40px; --cx: 0; --cy: 0; }
  .plane {
    position: absolute; inset: 0; width: 100%; height: 100%;
    transform: translate3d(calc(var(--cx) * var(--depth) * 10px), calc(var(--cy) * var(--depth) * 5px), 0);
    will-change: transform;
  }
  .copy { position: relative; }
  h1 { font-size: var(--step-5); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.3em; }
  .lede { font-size: var(--step-1); max-width: 34ch; color: var(--ink-soft); margin: 0 0 2rem; }
  .cta {
    display: inline-block;
    font-family: var(--font-display); font-weight: 600;
    background: var(--ink); color: var(--mist);
    padding: 0.8rem 1.4rem; border-radius: 999px; text-decoration: none;
  }
  .cta:hover { color: var(--mist); background: var(--pine); }
</style>
