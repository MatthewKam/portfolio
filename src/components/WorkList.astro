---
/** "Selected work" list, shared by the home page. */
import { getCollection } from 'astro:content';
import { sideProject } from '../data/sideProject';

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<section id="work" class="wrap work" aria-labelledby="work-title" data-x="WorkList.astro">
  <h2 id="work-title">Selected work<span>(click one to see a demo)</span></h2>
  <ul class="work-list">
    {work.map((item) => (
      <li>
        <a href={`/work/${item.id}`}>
          <span class="meta">{item.data.company}, {item.data.years}</span>
          <span class="title">{item.data.title}<span class="go" aria-hidden="true">→</span></span>
          <span class="summary">{item.data.summary}</span>
        </a>
      </li>
    ))}
    <li>
      <a href={sideProject.href}>
        <span class="meta">{sideProject.company}, {sideProject.years}</span>
        <span class="title">{sideProject.title}<span class="go" aria-hidden="true">→</span></span>
        <span class="summary">{sideProject.summary}</span>
      </a>
    </li>
  </ul>
</section>

<style>
  .work { padding-top: 5rem; scroll-margin-top: 4rem; }
  .work > h2 { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .work > h2 span { font-size: var(--step-0); margin-left: 10px; font-weight:normal;}
  .work-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--mist-deep); }
  .work-list li { border-bottom: 1px solid var(--mist-deep); }
  .work-list a {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding: 2rem 0;
    text-decoration: none;
  }
  @media (min-width: 52rem) {
    .work-list a { grid-template-columns: 13rem 1fr; column-gap: 2.5rem; }
    .work-list .meta { grid-row: span 2; padding-top: 0.6rem; }
  }
  .meta { font-family: var(--font-display); color: var(--ink-soft); font-size: var(--step--1); }
  .title { font-family: var(--font-display); font-weight: 600; font-size: var(--step-4); line-height: 1.05; letter-spacing: -0.02em; }
  .summary { max-width: 56ch; color: var(--ink-soft); }
  .work-list a { transition: transform 200ms ease; }
  .go { display: inline-block; margin-left: 0.35em; font-size: 0.6em; color: var(--lamp); opacity: 0; transform: translateX(-0.4em); transition: opacity 200ms ease, transform 200ms ease; }
  .work-list a:hover .title, .work-list a:focus-visible .title { color: var(--pine); }
  .work-list a:hover .go, .work-list a:focus-visible .go { opacity: 1; transform: none; }
  @media (hover: hover) { .work-list a:hover { transform: translateX(0.4rem); } }
</style>
