---
/**
 * The résumé as a picture: one row per role on a shared year axis,
 * then the same axis for the tools used in each role.
 * All content comes from src/data/career.ts.
 */
import { getCollection } from 'astro:content';
import { roles, stackRows, skills, type Role } from '../data/career';

const work = await getCollection('work', ({ data }) => !data.draft);
const workTitle = Object.fromEntries(work.map((w) => [w.id, w.data.title]));

const FIRST_YEAR = 2014;
const now = new Date();
const nowYM = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
const LAST_YEAR = now.getFullYear() + 1; // axis runs to Jan of next year
const span = (LAST_YEAR - FIRST_YEAR) * 12;
const years = Array.from({ length: LAST_YEAR - FIRST_YEAR }, (_, i) => FIRST_YEAR + i);

const months = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return (y - FIRST_YEAR) * 12 + (m - 1);
};
const pct = (n: number) => `${((n / span) * 100).toFixed(3)}%`;
const endOf = (r: Role) => r.end ?? nowYM;
const bar = (r: Role) => {
  const s = months(r.start);
  const e = months(endOf(r)) + 1; // end month is inclusive
  return `left:${pct(s)};width:${pct(e - s)}`;
};

const fmt = (ym: string) =>
  new Date(`${ym}-01T00:00:00`).toLocaleString('en-US', { month: 'short', year: 'numeric' });
const duration = (r: Role) => {
  const total = months(endOf(r)) - months(r.start) + 1;
  const y = Math.floor(total / 12);
  const m = total % 12;
  return [y && `${y} yr`, m && `${m} mo`].filter(Boolean).join(' ');
};

const ordered = [...roles].sort((a, b) => months(b.start) - months(a.start));
const nowPos = pct(months(nowYM) + 0.5);

const stack = stackRows.map((tool) => ({
  tool,
  uses: roles.filter((r) => r.stack.includes(tool)),
}));
---
<section id="experience" class="career wrap" aria-labelledby="career-title">
  <header class="head">
    <h2 id="career-title">Experience</h2>
    <p class="lede">Twelve years, front to back. Open a row for the details.</p>
    <a class="pdf" href="/resume.pdf">Résumé (PDF)</a>
  </header>

  <div class="chart" style={`--now:${nowPos};--years:${years.length}`}>
    <div class="row axis" aria-hidden="true">
      <span></span>
      <div class="ticks">
        {years.map((y) => (
          <span class:list={['tick', { odd: y % 2 }]} style={`left:${pct((y - FIRST_YEAR) * 12)}`}>
            {y}
          </span>
        ))}
      </div>
    </div>

    {ordered.map((r) => (
      <details class:list={['row role', r.kind]} name="role">
        <summary>
          <span class="label">
            <span class="company">{r.company}</span>
            <span class="title">{r.title}</span>
          </span>
          <span class="track">
            <span class="bar" style={bar(r)}>
              {r.kind === 'job' && <span class="bar-text">{duration(r)}</span>}
            </span>
          </span>
        </summary>
        <div class="detail">
          <p class="when">
            {r.start === endOf(r) ? fmt(r.start) : `${fmt(r.start)} – ${r.end ? fmt(r.end) : 'present'}`}
            {r.kind !== 'education' && <> · {duration(r)}</>}
            {r.location && <> · {r.location}</>}
          </p>
          <p class="summary">{r.summary}</p>
          {r.highlights.length > 0 && (
            <ul class="highlights">{r.highlights.map((h) => <li>{h}</li>)}</ul>
          )}
          {r.stack.length > 0 && (
            <ul class="chips" aria-label="Stack">{r.stack.map((s) => <li>{s}</li>)}</ul>
          )}
          {r.work?.filter((slug) => workTitle[slug]).length ? (
            <p class="case-links">
              Case studies:{' '}
              {r.work.filter((slug) => workTitle[slug]).map((slug, i) => (
                <>{i > 0 && ', '}<a href={`/work/${slug}`}>{workTitle[slug]}</a></>
              ))}
            </p>
          ) : null}
        </div>
      </details>
    ))}

    <h3 class="sub">Stack over time</h3>
    {stack.map(({ tool, uses }) => (
      <div class="row tool">
        <span class="label"><span class="company">{tool}</span></span>
        <span class="track">
          {uses.map((r) => (
            <span class="bar" style={bar(r)} title={`${tool} at ${r.company}`}></span>
          ))}
        </span>
        <span class="visually-hidden">
          Used at {uses.map((r) => r.company).join(', ')}
        </span>
      </div>
    ))}
  </div>

  <dl class="skills">
    {Object.entries(skills).map(([group, items]) => (
      <div>
        <dt>{group}</dt>
        <dd><ul class="chips">{items.map((s) => <li>{s}</li>)}</ul></dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .career { padding-top: 5rem; scroll-margin-top: 4rem; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.5rem; margin-bottom: 2rem; }
  .head h2 { font-size: var(--step-3); margin: 0; }
  .lede { margin: 0; color: var(--ink-soft); flex: 1 1 18rem; }
  .pdf { font-family: var(--font-display); font-weight: 600; }

  /* Rows share one grid: label column + track column. */
  .chart { --label: 15rem; position: relative; }
  .row > summary, .row.axis, .row.tool {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    align-items: center;
    column-gap: 1.25rem;
  }
  @media (max-width: 44rem) {
    .chart { --label: 1fr; }
    .row > summary, .row.axis, .row.tool { grid-template-columns: 1fr; row-gap: 0.4rem; }
    .row.axis > span:first-child { display: none; }
    .tick.odd { visibility: hidden; }
  }

  .track {
    position: relative; display: block; height: 1.75rem;
    background-image: linear-gradient(to right, var(--mist-deep) 1px, transparent 1px);
    background-size: calc(100% / var(--years, 13)) 100%;
  }
  /* "now" line through every track */
  .track::after {
    content: ''; position: absolute; top: -0.4rem; bottom: -0.4rem; left: var(--now);
    border-left: 2px dashed var(--lamp);
  }

  .axis .ticks { position: relative; height: 1.5rem; }
  .tick {
    position: absolute; top: 0; padding-left: 0.3rem;
    font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-soft);
  }

  .bar {
    position: absolute; top: 0.2rem; bottom: 0.2rem; border-radius: 999px;
    background: var(--ink); min-width: 0.6rem;
    display: flex; align-items: center; overflow: hidden;
  }
  .bar-text {
    padding-inline: 0.7rem; white-space: nowrap;
    font-family: var(--font-display); font-size: var(--step--1); font-weight: 500; color: var(--mist);
  }
  .freelance .bar { top: 0.65rem; bottom: 0.65rem; background: var(--pine); }
  .education .bar { background: var(--lamp); top: 0.35rem; bottom: 0.35rem; width: 1.05rem !important; transform: translateX(-25%); }

  .role { border-top: 1px solid var(--mist-deep); }
  .role:last-of-type { border-bottom: 1px solid var(--mist-deep); }
  summary {
    list-style: none; cursor: pointer; padding-block: 1rem;
    position: relative;
  }
  summary::-webkit-details-marker { display: none; }
  .label { display: flex; flex-direction: column; padding-left: 1.6rem; position: relative; }
  .role .label::before {
    content: '+'; position: absolute; left: 0; top: -0.05rem;
    font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: 1;
    color: var(--ink-soft); transition: transform 200ms ease;
  }
  .role[open] .label::before { transform: rotate(45deg); }
  .company { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: 1.2; }
  .title { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-soft); }
  summary:hover .company { color: var(--pine); }
  summary:hover .bar { background: var(--pine); }
  .freelance summary:hover .bar { background: var(--ink); }

  .detail { padding: 0 0 1.75rem calc(var(--label) + 1.25rem); max-width: calc(var(--label) + 1.25rem + var(--measure)); }
  @media (max-width: 44rem) { .detail { padding-left: 1.6rem; } }
  .when { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-soft); margin: 0 0 0.4rem; }
  .summary { margin: 0 0 0.8rem; font-style: italic; }
  .highlights { margin: 0 0 1rem; padding-left: 1.1rem; }
  .highlights li { margin-bottom: 0.4rem; }
  .highlights li::marker { color: var(--pine); }
  .case-links { font-family: var(--font-display); margin: 0.8rem 0 0; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .chips li {
    font-family: var(--font-display); font-size: var(--step--1); font-weight: 500;
    padding: 0.15rem 0.65rem; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--mist-deep);
  }

  .sub { font-size: var(--step-1); margin: 3rem 0 0.75rem; }
  .row.tool { padding-block: 0.2rem; }
  .tool .company { font-size: var(--step-0); font-weight: 500; }
  .tool .label { padding-left: 0; }
  .tool .track { height: 1.1rem; }
  .tool .bar { background: var(--pine); opacity: 0.85; top: 0.25rem; bottom: 0.25rem; }
  @media (max-width: 44rem) { .row.tool { padding-block: 0.4rem; } }

  .skills {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem 2.5rem; margin: 3.5rem 0 0; padding-top: 2rem; border-top: 1px solid var(--mist-deep);
  }
  .skills dt { font-family: var(--font-display); font-weight: 600; margin-bottom: 0.6rem; }
  .skills dd { margin: 0; }
</style>
