---
/**
 * "< All work" on the project pages. When the visitor came from another page on
 * this site (home, the rewards or receipt view, the terminal), it goes back there,
 * to the same scroll position, and says where. Otherwise it links to the home
 * page's work list.
 */
---
<a class="back" href="/#work" data-back>&lt; <span data-back-label>All work</span></a>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-back]');
  const LABELS: Record<string, string> = { '/': 'All work', '/rewards': 'Ways to earn', '/receipt': 'Receipt', '/live': 'Live' };
  try {
    const from = document.referrer ? new URL(document.referrer) : null;
    if (link && from && from.origin === location.origin && from.pathname !== location.pathname && history.length > 1) {
      const path = from.pathname.replace(/(.)\/$/, '$1');
      link.href = from.href;
      link.querySelector('[data-back-label]')!.textContent = LABELS[path] ?? 'Back';
      // history.back() restores where they were on that page; the href is the fallback.
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        history.back();
      });
    }
  } catch {
    // Keep the default link.
  }
</script>

<style>
  .back { font-family: var(--font-display); font-size: var(--step--1); color: var(--ink-soft); }
</style>
